NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 접두사 붙이지 말 것 — 회원가입의 auth.admin.createUser에 사용.
# Supabase 대시보드 > Settings > API > service_role key 에서 가져온다.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# Prisma — Supabase는 포트가 다르다. migrate는 반드시 direct(5432)로 간다.
DATABASE_URL=  # pooler, port 6543, ?pgbouncer=true
DIRECT_URL=    # direct, port 5432