// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IncomeCategory {
  allowance
  salary
  scholarship
  cashback
  irregular
}

enum BudgetStatus {
  DRAFT
  CONFIRMED
  DEFICIT_ALERT
}

enum FixedExpenseCategory {
  TRANSPORT
  RENT
  PHONE
  SUBSCRIPTION
}

/// 원본 입출금 내역. 금액은 입금+/출금- 정수(원).
model Transaction {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  occurredAt   DateTime @map("occurred_at")
  amount       Int
  rawDesc      String   @map("raw_desc")
  counterparty String   @map("counterparty")

  incomeEvent IncomeEvent?

  @@map("transactions")
}

/// 입금 건 하나를 소득원/카테고리로 분류한 결과. transactions와 1:1.
model IncomeEvent {
  txId            String         @id @map("tx_id")
  sourceId        String         @map("source_id")
  category        IncomeCategory
  confidence      Float
  isUserConfirmed Boolean        @map("is_user_confirmed")

  transaction Transaction @relation(fields: [txId], references: [id])

  @@map("income_events")
}

/// 소득원 하나의 주기·금액분포·생존여부 학습 결과. sourceId = 정규화된 counterparty+category 그룹 키.
model SourceProfile {
  sourceId         String         @id @map("source_id")
  category         IncomeCategory
  periodDays       Float          @map("period_days")
  periodConfidence Float          @map("period_confidence")
  typicalDom       Int?           @map("typical_dom")
  amountMu         Int            @map("amount_mu")
  amountSigma      Float          @map("amount_sigma")
  occurrenceProb   Float          @map("occurrence_prob")
  lastSeen         DateTime       @map("last_seen")
  alive            Boolean        @default(true)

  @@map("source_profiles")
}

/// 월별 예산안. aiAllocations(AI 원안)은 확정 후에도 절대 덮어쓰지 않는다 — 피드백 학습의 기준값.
model BudgetPlan {
  id            String       @id @default(cuid())
  userId        String       @map("user_id")
  targetMonth   String       @map("target_month")
  baseIncome    Int          @map("base_income")
  aiAllocations Json         @map("ai_allocations")
  allocations   Json
  saving        Int
  status        BudgetStatus @default(DRAFT)

  @@map("budget_plans")
}

/// 사용자별 카테고리 가중치(피드백 학습 대상)와 저축률.
model UserPreference {
  id         String  @id @default(cuid())
  userId     String  @unique @map("user_id")
  nickname   String? @map("nickname")
  weights    Json
  savingRate Float   @default(0.10) @map("saving_rate")

  @@map("user_preferences")
}

enum PiggyBankItemStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum PiggyBankCategory {
  PARKING
  SAVINGS
  STOCK
  OTHER
}

/// 저금통(통장/주식/적금 등) 항목. 저금통 페이지에서 카드로 표시.
model PiggyBankItem {
  id            String              @id @default(cuid())
  userId        String              @map("user_id")
  title         String
  category      PiggyBankCategory   @default(OTHER)
  targetAmount  Int                 @map("target_amount")
  currentAmount Int                 @default(0) @map("current_amount")
  startDate     DateTime?           @map("start_date")
  targetDate    DateTime?           @map("target_date")
  status        PiggyBankItemStatus @default(PENDING)

  @@map("piggybank_items")
}

enum LedgerEntryType {
  EXPENSE
  INCOME
}

enum PaletteColor {
  DEFAULT
  GRAY
  BROWN
  ORANGE
  YELLOW
  GREEN
  BLUE
  PURPLE
  PINK
  RED
}

/// AI피그 지출 예산 그룹(현희 쪽 고정 5분류). LedgerCategory가 여기 매핑돼야 AI 계산에서 누락되지 않는다.
enum ExpenseCategory {
  FOOD
  CAFE
  SHOPPING
  TRANSPORT
  OTHER
}

/// 지출/수입 "구분" 옵션 목록. 마이페이지 설정에서 사용자가 직접 추가·수정·삭제한다.
/// type에 따라 expenseGroup(지출) 또는 incomeGroup(수입) 중 하나만 채워진다 — AI피그 예산 계산이 참조하는 고정 그룹.
model LedgerCategory {
  id           String          @id @default(cuid())
  userId       String          @map("user_id")
  label        String
  color        PaletteColor    @default(DEFAULT)
  sortOrder    Int             @default(0) @map("sort_order")
  type         LedgerEntryType
  expenseGroup ExpenseCategory? @map("expense_group")
  incomeGroup  IncomeCategory?  @map("income_group")

  entries LedgerEntry[]

  @@unique([userId, label])
  @@map("ledger_categories")
}

/// 사용자가 직접 기입하는 월별 지출/수입 계획표. 은행 자동분류(Transaction/IncomeEvent)와는 별개.
model LedgerEntry {
  id          String          @id @default(cuid())
  userId      String          @map("user_id")
  date        DateTime
  type        LedgerEntryType
  categoryId  String          @map("category_id")
  description String
  amount      Int
  isDone      Boolean         @default(false) @map("is_done")

  category LedgerCategory @relation(fields: [categoryId], references: [id])

  @@map("ledger_entries")
}

/// 사용자가 "종료 확정"한 소득원. 계산으로는 알 수 없는 사용자의 판단이라 저장이 필요하다.
/// sourceId = sourcePipeline.ts의 정규화된 소득원 키(정규화counterparty:category).
/// sourceId 단독으로는 사용자 간에 겹칠 수 있어(같은 정규화 거래처명+카테고리) userId까지 묶어 복합키로 잡는다.
model SourceTermination {
  sourceId    String   @map("source_id")
  userId      String   @map("user_id")
  confirmedAt DateTime @default(now()) @map("confirmed_at")

  @@id([sourceId, userId])
  @@map("source_terminations")
}

/// 사용자가 설정한 카테고리별 고정지출. 온보딩(예산 화면 첫 진입) 시 시드되고, 마이페이지에서 수정 가능.
/// BudgetPlanner의 "고정지출 입력"은 이 합계를 기본값으로 불러온다(override 가능).
model FixedExpense {
  id       String               @id @default(cuid())
  userId   String               @map("user_id")
  category FixedExpenseCategory
  amount   Int

  @@unique([userId, category])
  @@map("fixed_expenses")
}
